{
  "name": "@kit/i18n-tools",
  "version": "0.0.28",
  "description": "I18n automation tools for Vue/React projects",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "i18n-tools": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "build": "pnpm run clean && tsdown",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.41",
    "@vue/compiler-sfc": "^3.5.41",
    "chalk": "catalog:",
    "dotenv": "catalog:",
    "inquirer": "catalog:",
    "jiti": "catalog:",
    "openai": "catalog:",
    "picomatch": "catalog:",
    "typescript": "catalog:",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@kit/eslint-config": "workspace:^",
    "@kit/typescript-config": "workspace:^",
    "@kit/vitest-config": "workspace:^",
    "@types/inquirer": "^9.0.10",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/yargs": "^17.0.35",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
