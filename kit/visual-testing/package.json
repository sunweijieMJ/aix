{
  "name": "@kit/visual-testing",
  "version": "0.0.3",
  "description": "Visual regression testing with Figma baseline and LLM analysis",
  "author": "<sunweijie@able-elec.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "visual-test": "./dist/cli.js"
  },
  "keywords": [
    "visual-testing",
    "regression-testing",
    "figma",
    "llm",
    "screenshot",
    "comparison"
  ],
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "build": "pnpm run clean && tsdown",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "chalk": "catalog:",
    "commander": "catalog:",
    "cosmiconfig": "^10.0.0",
    "eta": "catalog:",
    "fs-extra": "catalog:",
    "inquirer": "catalog:",
    "ora": "catalog:",
    "p-limit": "^7.3.1",
    "picomatch": "catalog:",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.78.0 || ^0.120.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "openai": "^6.22.0 || ^7.0.0",
    "playwright": "^1.58.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@kit/eslint-config": "workspace:^",
    "@kit/typescript-config": "workspace:^",
    "@kit/vitest-config": "workspace:^",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "catalog:",
    "openai": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
